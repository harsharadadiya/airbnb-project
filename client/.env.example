# ---------------------------------------------
# StayNest frontend settings
# Copy this file to ".env" if you need to change anything.
# ---------------------------------------------

# Address of the API.
# Leave it as /api for local development (Vite forwards it to http://localhost:5000).
# In production set the full URL, e.g. https://staynest-api.onrender.com/api
VITE_API_URL=/api

# Currency used to show prices (any ISO code: USD, INR, EUR, ...)
VITE_CURRENCY=USD
