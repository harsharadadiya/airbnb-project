# ---------------------------------------------
# StayNest API settings
# Copy this file to ".env" and change the values.
# ---------------------------------------------

# "development" on your computer, "production" when deployed
NODE_ENV=development

# Port the API listens on
PORT=5000

# MongoDB connection string
#   Local MongoDB:  mongodb://127.0.0.1:27017/staynest
#   MongoDB Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/staynest?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/staynest

# Secret used to sign login tokens. Use a long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret-string

# How long a login lasts (examples: 1h, 7d, 30d)
JWT_EXPIRES_IN=7d

# Frontend address(es) allowed to call the API. Separate several with commas.
CLIENT_URL=http://localhost:5173
